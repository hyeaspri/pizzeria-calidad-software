# Copia este archivo como .env y completa tus datos de MySQL
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=tu_contraseña
DB_NAME=pizzeria
DB_PORT=3306

# Base que usan las pruebas automáticas (se borra y recrea en cada "npm test")
DB_NAME_TEST=pizzeria_test

# Servidor
PORT=3000
COSTO_DOMICILIO=5000
# Orígenes permitidos separados por coma (vacío = cualquiera, solo para desarrollo)
CORS_ORIGIN=
