{
  "name": "pizzeria-calidad-software",
  "version": "2.0.0",
  "description": "Sistema de Gestión de Pedidos para Pizzería - Estándares y Métricas + Ingeniería Web",
  "main": "app.js",
  "scripts": {
    "start": "node app.js",
    "dev": "node --watch app.js",
    "db:crear": "mysql -u root -p < pizzeria.sql",
    "db:exportar": "mysqldump -u root -p --databases pizzeria --routines --triggers --result-file=pizzeria_export.sql",
    "test": "node --test --test-concurrency=1 --test-reporter=spec --test-reporter-destination=stdout --test-reporter=./tests/reporte-ieee829.mjs --test-reporter-destination=docs/informe-ejecucion-pruebas.md \"tests/*.test.js\""
  },
  "author": "Paula Román, Heidy Asprilla, Hayder Carreño, Daniela Rodríguez",
  "license": "ISC",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "mysql2": "^3.23.4"
  },
  "devDependencies": {
    "supertest": "^7.3.2"
  }
}
